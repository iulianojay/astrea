<codeline lineno="207"><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>d<sp/><sp/>=<sp/>y2<sp/>*<sp/>d<sp/>-<sp/>dd<sp/>+<sp/>coeff[k];</highlight></codeline>
<codeline lineno="208"><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>dd<sp/>=<sp/>sv;</highlight></codeline>
<codeline lineno="209"><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline lineno="210"><highlight class="normal"></highlight></codeline>
<codeline lineno="211"><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>Normalize<sp/>to<sp/>the<sp/>interval<sp/>ub<sp/>-<sp/>lb</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="212"><highlight class="normal"><sp/><sp/><sp/><sp/></highlight><highlight class="keywordflow">return</highlight><highlight class="normal"><sp/>2.0<sp/>/<sp/>(ub<sp/>-<sp/>lb)<sp/>*<sp/>(y<sp/>*<sp/>dp<sp/>-<sp/>ddp<sp/>+<sp/>d);</highlight></codeline>
<codeline lineno="213"><highlight class="normal">}</highlight></codeline>

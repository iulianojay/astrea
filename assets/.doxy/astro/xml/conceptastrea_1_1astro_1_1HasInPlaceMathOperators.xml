concept <ref refid="conceptastrea_1_1astro_1_1HasInPlaceMathOperators" kindref="compound">astrea::astro::HasInPlaceMathOperators</ref> =  requires(T elements, const T other, const Unitless scalar) {
    { elements += other };
    { elements -= other };
    { elements *= scalar };
    { elements /= scalar };
}    </initializer>

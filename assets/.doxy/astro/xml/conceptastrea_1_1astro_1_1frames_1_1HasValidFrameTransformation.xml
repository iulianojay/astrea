    <initializer>template&lt;IsFrame auto frame, IsFrame auto frame_u&gt;
concept <ref refid="conceptastrea_1_1astro_1_1frames_1_1HasValidFrameTransformation" kindref="compound">astrea::astro::frames::HasValidFrameTransformation</ref> =  requires(Date date) {
    { get_dcm_impl&lt;frame, frame_u&gt;(date) } -&gt; std::same_as&lt;DCM&lt;frame, frame_u&gt;&gt;;
} || requires(Date date) {
    { get_dcm_impl&lt;frame_u, frame&gt;(date) } -&gt; std::same_as&lt;DCM&lt;frame_u, frame&gt;&gt;;
}    </initializer>
    <briefdescription>
<para>Concept to determine if a valid frame transformation (DCM) can be obtained between two frames at a given date, either through a direct DCM or an inverse DCM. </para>
    </briefdescription>
    <detaileddescription>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>

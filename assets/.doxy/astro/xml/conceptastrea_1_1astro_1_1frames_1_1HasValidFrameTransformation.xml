</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>frame_u</parametername>
</parameternamelist>
<parameterdescription>
<para>The second frame type to check. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>date</parametername>
</parameternamelist>
<parameterdescription>
<para>The date at which to obtain the DCM. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if a valid DCM can be obtained between the two frames, false otherwise. </para>
</simplesect>
</para>
